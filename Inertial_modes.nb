Cell[CellGroupData[{

Cell["Calculate velocity field", "Subsection",
 CellChangeTimes->{{3.673777899495584*^9, 
  3.673777903967095*^9}},ExpressionUUID->"d20573c4-0479-45d0-9701-\
0e2c968268de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"C3D", "[", 
   RowBox[{"i_", ",", "j_", ",", "m_", ",", "NG_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"i", "+", "j"}], ")"}]}], 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"m", "+", "NG", "+", "i", "+", "j"}], ")"}]}], "-", "1."}], 
      ")"}], "!!"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"j", "+", "1"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "i"}], "-", "1"}], ")"}], "!!"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"NG", "-", "i", "-", "j"}], ")"}], "!"}], 
      RowBox[{"i", "!"}], 
      RowBox[{"j", "!"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "+", "j"}], ")"}], "!"}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.672467287902072*^9, 3.67246730240921*^9}, 
   3.6737624590440607`*^9, 3.673762862599813*^9, {3.673777915049946*^9, 
   3.673777952374712*^9}, {3.673778271257672*^9, 3.673778271493577*^9}, 
   3.7069091357658987`*^9, 3.706918048638104*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"47804df2-f59c-4fc4-8ab4-f461be9bf403"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Us3D", "[", 
   RowBox[{"s_", ",", "z_", ",", "m_", ",", "NG_", ",", "n_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    RowBox[{"Sum", "[", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"C3D", "[", 
        RowBox[{"i", ",", "j", ",", "m", ",", "NG"}], "]"}], 
       RowBox[{
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"sigma", "[", 
           RowBox[{"m", ",", "NG"}], "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", "i"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", " ", 
            RowBox[{
             RowBox[{"sigma", "[", 
              RowBox[{"m", ",", "NG"}], "]"}], "[", 
             RowBox[{"[", "n", "]"}], "]"}], ")"}], "^", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"j", "-", "1"}], ")"}]}], 
       RowBox[{"(", 
        RowBox[{"m", "+", 
         RowBox[{"m", " ", 
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"m", ",", "NG"}], "]"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}], ")"}]}], "+", 
         RowBox[{"2", "j", " ", 
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"m", ",", "NG"}], "]"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}], ")"}]}]}], ")"}], 
       RowBox[{"s", "^", 
        RowBox[{"(", 
         RowBox[{"m", "+", 
          RowBox[{"2", "j"}], "-", "1"}], ")"}]}], 
       RowBox[{"z", "^", 
        RowBox[{"(", 
         RowBox[{"2", "i"}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "NG"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", 
        RowBox[{"NG", "-", "i"}]}], "}"}]}], "]"}]}], " ", "//", " ", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.672467311060519*^9, 3.672467360354661*^9}, {
  3.672467408548011*^9, 3.672467409500742*^9}, {3.673777922055544*^9, 
  3.67377800909303*^9}, {3.673778142351972*^9, 3.673778168368978*^9}, {
  3.673778276732232*^9, 3.673778277012484*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"eae77bc2-437a-4b73-8ad6-5b6dfb9f8d14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Uz3D", "[", 
   RowBox[{"s_", ",", "z_", ",", "m_", ",", "NG_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"C3D", "[", 
       RowBox[{"i", ",", "j", ",", "m", ",", "NG"}], "]"}], 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{"sigma", "[", 
          RowBox[{"m", ",", "NG"}], "]"}], "[", 
         RowBox[{"[", "n", "]"}], "]"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "i"}], "-", "1"}], ")"}]}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"m", ",", "NG"}], "]"}], "[", 
            RowBox[{"[", "n", "]"}], "]"}], ")"}], "^", "2"}]}], ")"}], "^", 
       "j"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", "i"}], " ", ")"}], 
      RowBox[{"s", "^", 
       RowBox[{"(", 
        RowBox[{"m", "+", 
         RowBox[{"2", "j"}]}], ")"}]}], 
      RowBox[{"z", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "i"}], "-", "1"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "NG"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{"NG", "-", "i"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.672467391654598*^9, 3.672467415938102*^9}, {
  3.673777924104925*^9, 3.673777932848174*^9}, {3.67377817285236*^9, 
  3.673778197475066*^9}, {3.673778278358501*^9, 3.673778278642337*^9}, {
  3.706909023843947*^9, 3.706909026010079*^9}, {3.9577818468602076`*^9, 
  3.9577818473043394`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"0d3aa771-cdde-4ac0-9af0-c2bbd00482b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Uphi3D", "[", 
   RowBox[{"s_", ",", "z_", ",", "m_", ",", "NG_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"C3D", "[", 
      RowBox[{"i", ",", "j", ",", "m", ",", "NG"}], "]"}], 
     RowBox[{
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"sigma", "[", 
         RowBox[{"m", ",", "NG"}], "]"}], "[", 
        RowBox[{"[", "n", "]"}], "]"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"2", "i"}], ")"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{"sigma", "[", 
            RowBox[{"m", ",", "NG"}], "]"}], "[", 
           RowBox[{"[", "n", "]"}], "]"}], ")"}], "^", "2"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"j", "-", "1"}], ")"}]}], 
     RowBox[{"(", 
      RowBox[{"m", "+", 
       RowBox[{"m", " ", 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"sigma", "[", 
           RowBox[{"m", ",", "NG"}], "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}], ")"}]}], " ", "+", " ", 
       RowBox[{"2", "j"}]}], ")"}], " ", 
     RowBox[{"s", "^", 
      RowBox[{"(", 
       RowBox[{"m", "+", 
        RowBox[{"2", "j"}], "-", "1"}], ")"}]}], " ", 
     RowBox[{"z", "^", 
      RowBox[{"(", 
       RowBox[{"2", "i"}], ")"}]}]}], " ", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "NG"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", 
      RowBox[{"NG", "-", "i"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.672467482201573*^9, 3.672467537380756*^9}, {
  3.672467582539919*^9, 3.672467633597031*^9}, {3.673777935052658*^9, 
