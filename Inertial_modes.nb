Cell[CellGroupData[{

Cell["\<\
Generate the figures for u_s as they appear on Maffei, Jackson and Livermore \
(Characterisation of columnar inertial modes in rapidly rotating spheres and \
spheroids)\
\>", "Subsection",
 CellChangeTimes->{{3.709583475820161*^9, 3.709583518450089*^9}, {
  3.709583643941114*^9, 
  3.709583645386722*^9}},ExpressionUUID->"6f8550e3-2e5d-44d2-b35d-\
9f95ffaef226"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NFs", "=", 
   RowBox[{
    RowBox[{"FindMaximum", "[", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"U3D", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "z"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{"U3D", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", 
      RowBox[{"Re", "[", 
       RowBox[{"U3D", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}], "/", "NFs"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"RegionFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        SuperscriptBox["s", "2"], "+", 
        SuperscriptBox["z", "2"]}], "\[LessEqual]", "1"}]}], "]"}]}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<s\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   RowBox[{"BoundaryStyle", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"BarLegend", "[", 
     RowBox[{"Automatic", ",", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"FontSize", "\[Rule]", "20"}], "}"}]}]}], "]"}]}], ",", 
   RowBox[{"TicksStyle", "\[Rule]", "Large"}], ",", 
   RowBox[{"AxesStyle", "\[Rule]", "Thick"}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", "Large"}], ",", 
   RowBox[{"Contours", "\[Rule]", "6"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}]}], "]"}]}], "Input",
