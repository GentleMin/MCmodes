Cell[BoxData[
 RowBox[{
  RowBox[{"WA", "[", 
   RowBox[{"NG_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "  ", 
      RowBox[{
       RowBox[{
