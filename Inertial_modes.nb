Notebook[{

Cell[CellGroupData[{
Cell["QG Inertial modes in a sphere", "Title",
 CellChangeTimes->{{3.622372683370729*^9, 
  3.622372687668729*^9}},ExpressionUUID->"3d90530e-e41d-4682-a0bf-\
865bccb10761"],

Cell["\<\
This script codes the formulas of Zhang et al., 2001 \
(\[OpenCurlyDoubleQuote]On inertial waves in a rotating fluid sphere\
\[CloseCurlyDoubleQuote]) and calculates equatorially symmetric inertial \
normal modes. This code has been uploaded as supplementary material to \
Maffei, Jackson and Livermore \[OpenCurlyDoubleQuote]Characterisation of \
columnar inertial modes in rapidly rotating spheres and spheroids\
\[CloseCurlyDoubleQuote] (PRSA) and has been used to generate the QGIW \
solutions of figures 3 and 4. It can, however be used to visualize general 3D \
solutions in a sphere.

Usage: Evaluate the notebook and change the parameters m1, n1, i1, to view \
different modes.\
\>", "Text",
 CellChangeTimes->{{3.709583333127009*^9, 3.709583398652663*^9}, {
  3.709583912480152*^9, 3.709584086183919*^9}, {3.911298914083532*^9, 
  3.911298914813545*^9}},ExpressionUUID->"1189ce5d-818c-4d67-b689-\
b0f3200963ec"],

Cell[CellGroupData[{

Cell["Equatorially symmetric modes", "Section",
 CellChangeTimes->{{3.7095831784774237`*^9, 3.7095831829838953`*^9}, 
   3.709583380742284*^9},ExpressionUUID->"03d12e91-d4e9-4a4d-837e-\
d761294929f9"],

Cell[CellGroupData[{

Cell["Find the frequencies", "Subsection",
 CellChangeTimes->{{3.673777263370305*^9, 
  3.673777270423392*^9}},ExpressionUUID->"3f0fff98-65a0-4bf5-9dac-\
adb1af486030"],

Cell[BoxData[
 RowBox[{
  RowBox[{"W", "[", 
   RowBox[{"NG_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", "j"}], " ", 
       RowBox[{
        RowBox[{"Factorial", "[", 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "NG"}], " ", "+", " ", "m", " ", "-", " ", 
            "j"}], ")"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Factorial", "[", "j", "]"}], 
          RowBox[{"Factorial", "[", 
           RowBox[{
            RowBox[{"2", " ", "NG"}], "+", "m", "-", "j"}], "]"}], 
          RowBox[{"Factorial", "[", 
           RowBox[{"2", 
            RowBox[{"(", 
             RowBox[{"NG", "-", "j"}], ")"}]}], "]"}]}], ")"}]}]}], " ", 
      ")"}], " ", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "+", 
         RowBox[{"2", " ", "NG"}], " ", "-", " ", 
         RowBox[{"2", " ", "j"}]}], ")"}], " ", "-", " ", 
       RowBox[{"2", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"NG", "-", "j"}], ")"}], "/", "\[Sigma]"}]}]}], "  ", ")"}],
      " ", 
     RowBox[{"\[Sigma]", "^", 
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"NG", "-", "j"}], ")"}]}], ")"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "NG"}], "}"}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.673777312296829*^9, 3.673777463053852*^9}, {
  3.673777547355756*^9, 3.673777547462161*^9}, {3.673778075496145*^9, 
  3.673778082119139*^9}, {3.915009405251093*^9, 3.915009442532819*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5060053e-598e-4c51-ac8e-8aa13a3eb35a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sigma", "[", 
   RowBox[{"m_", ",", "NG_"}], "]"}], ":=", 
  RowBox[{"\[Sigma]", "/.", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"W", "[", 
       RowBox[{"NG", ",", "m"}], "]"}], "\[Equal]", "0"}], ",", "\[Sigma]"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.673777501893757*^9, 3.673777540753696*^9}, {
  3.673777576090178*^9, 3.673777579714037*^9}, {3.673777740082749*^9, 
  3.673777766725396*^9}, {3.673778052777913*^9, 3.673778098523293*^9}, {
  3.673778131106501*^9, 3.673778137055751*^9}, {3.6737810943735538`*^9, 
  3.673781098647743*^9}, {3.67386648698335*^9, 3.673866488872272*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a902d414-cd6f-49d9-86f5-34b92231943f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"sigma", "[", 
     RowBox[{"3", ",", " ", "2"}], "]"}], ",", " ", "18"}], "]"}], "*", 
  "2"}]], "Input",
 CellChangeTimes->{{3.9576753931631165`*^9, 3.9576753932073617`*^9}, {
  3.9576754866206713`*^9, 3.957675490038802*^9}, {3.957675546318966*^9, 
