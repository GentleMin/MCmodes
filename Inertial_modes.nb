  3.9576825681981125`*^9, 3.9576825706018057`*^9}, {3.9576826857878637`*^9, 
  3.957682685821704*^9}, {3.9576828176696563`*^9, 3.9576828176879187`*^9}, {
  3.9577781572345376`*^9, 3.9577781572982388`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"ad89232f-ac0c-4e1c-a814-4ba919139b5f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
