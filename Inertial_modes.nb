Cell[BoxData[{
 RowBox[{
  RowBox[{"m1", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"N1", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigma", "[", 
    RowBox[{"m1", ",", "N1"}], "]"}], "//", "N"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U3D", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Us3D", "[", 
       RowBox[{"s", ",", "z", ",", "m1", ",", "N1", ",", "n1"}], "]"}], ",", 
      RowBox[{"Uphi3D", "[", 
       RowBox[{"s", ",", "z", ",", "m1", ",", "N1", ",", "n1"}], "]"}], ",", 
      RowBox[{"Uz3D", "[", 
       RowBox[{"s", ",", "z", ",", "m1", ",", "N1", ",", "n1"}], "]"}]}], 
     "}"}], 
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", "m1", " ", "phi"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U3DS", "=", 
   RowBox[{"TransformedField", "[", 
    RowBox[{
     RowBox[{"\"\<Cylindrical\>\"", "\[Rule]", "\"\<Spherical\>\""}], ",", 
     "U3D", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "phi", ",", "z"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"R", ",", "Th", ",", "Ph"}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",
